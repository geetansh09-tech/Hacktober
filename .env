# ============================================================
# BlackBox Atlas — configuration (runs entirely on an NVIDIA API key)
# Copy to .env (run.sh / run.ps1 do this for you) and paste your key below.
# ============================================================

# --- NVIDIA hosted NIM API (https://build.nvidia.com) ---
# Free key (starts with "nvapi-"): sign in at build.nvidia.com, open any model page, click "Get API Key".
# This ONE key powers both embeddings (semantic grouping + search) and the optional LLM enrichment.
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# --- Optional LLM enrichment, also served by NVIDIA (OpenAI-compatible chat API) ---
# Leave LLM_API_KEY empty: it automatically reuses NVIDIA_API_KEY.
LLM_API_KEY=
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_MODEL=meta/llama-3.1-70b-instruct

# Similarity threshold for 'related pages' groups. Leave unset for auto-tuning (recommended).
# ATLAS_EMBED_SIMILARITY=0.75

# --- Backend (all optional) ---
ATLAS_DB=atlas.db
ATLAS_MAX_CONCURRENT=2
# Custom Chromium (e.g. in containers). Normally leave unset after `playwright install chromium`.
# ATLAS_BROWSER_PATH=/usr/bin/chromium
# ATLAS_BROWSER_ARGS=--no-sandbox
